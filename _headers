# ============================================================================
#  MEMO — En-têtes de sécurité HTTP  (tâche S09)
#
#  Où le déposer : à la racine du dossier publié.
#    - Cloudflare Pages  → fichier « _headers » à la racine (reconnu tel quel)
#    - Netlify           → fichier « _headers » à la racine (format identique)
#    - Autre hébergeur   → recopier ces valeurs dans sa configuration
#
#  À vérifier après mise en ligne : https://securityheaders.com
# ============================================================================

/*
  # Interdit l'affichage de MEMO dans un cadre sur un autre site.
  # Protège contre le détournement de clic : un site malveillant qui superpose
  # un bouton invisible au-dessus du vôtre pour vous faire cliquer sans le voir.
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

  # Empêche le navigateur de « deviner » le type d'un fichier servi.
  X-Content-Type-Options: nosniff

  # Ne transmet jamais l'adresse complète de la page aux sites tiers.
  # Sans cela, un identifiant présent dans l'adresse peut fuiter vers un autre site.
  Referrer-Policy: strict-origin-when-cross-origin

  # Impose HTTPS pendant 2 ans, sous-domaines compris.
  # À n'activer qu'une fois le certificat en place et vérifié : c'est irréversible
  # pendant la durée annoncée, un navigateur refusera ensuite toute connexion non chiffrée.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

  # MEMO n'a besoin d'aucun capteur : on les refuse tous explicitement.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Isole MEMO des autres onglets ouverts.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # --- Politique de sécurité du contenu -------------------------------------
  # Déclare les seules origines autorisées. Tout le reste est bloqué par le navigateur.
  #
  #   script-src  : MEMO et le SDK Supabase (chargé depuis jsDelivr).
  #                 'unsafe-inline' est nécessaire tant que le code vit dans la page ;
  #                 il disparaîtra quand le script sera sorti dans un fichier (à faire au lot 0).
  #   connect-src : les appels vers votre projet Supabase uniquement.
  #   img-src     : images de la page et images encodées (data:).
  #   object-src  : aucun greffon.
  #   base-uri    : empêche la réécriture de l'adresse de base de la page.
  #   form-action : aucun envoi de formulaire vers un autre site.
  #
  # REMPLACEZ fjfqigyxeejxztaivqui par l'identifiant de votre projet si vous en changez.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://fjfqigyxeejxztaivqui.supabase.co wss://fjfqigyxeejxztaivqui.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Les fichiers versionnés peuvent être mis en cache longtemps.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# La page principale ne doit jamais être servie depuis un cache périmé :
# sinon une correction de sécurité peut mettre des jours à atteindre un utilisateur.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
